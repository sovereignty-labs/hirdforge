FROM golang:1.23-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /temporal-worker ./cmd/temporal-worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /temporal-worker /usr/local/bin/temporal-worker

ENTRYPOINT ["/usr/local/bin/temporal-worker"]