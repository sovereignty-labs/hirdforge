# Build stage
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY pkg/ pkg/
COPY proto/ proto/
RUN go vet ./...
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /astgraph ./cmd/astgraph/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates && adduser -D -u 1000 operator
COPY --from=build /astgraph /usr/local/bin/astgraph
USER operator
WORKDIR /workspace
ENTRYPOINT ["astgraph"]
