# Build stage
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY pkg/ pkg/
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /hirdforge ./cmd/hirdforge/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates kubectl && adduser -D -u 1000 operator
COPY --from=build /hirdforge /usr/local/bin/hirdforge
USER operator
WORKDIR /workspace
ENTRYPOINT ["hirdforge"]
