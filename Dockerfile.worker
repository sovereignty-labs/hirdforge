# Multi-stage build for Temporal Worker binary
# Build stage: compile in golang:1.23-alpine
FROM golang:1.23-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-install-recommends ca-certificates git

# Copy go mod files first for dependency caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source and compile
COPY cmd/worker/ ./cmd/worker/
COPY pkg/workflows/ ./pkg/workflows/
RUN CGO_ENABLED=0 GOOS=linux go build -o /temporal-worker ./cmd/worker/

# Runtime stage: debian:bookworm-slim for glibc compatibility
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 worker

COPY --from=builder /temporal-worker /usr/local/bin/temporal-worker

USER worker
WORKDIR /home/worker

ENTRYPOINT ["/usr/local/bin/temporal-worker"]
