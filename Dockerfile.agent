# Build stage
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd/ cmd/
COPY pkg/ pkg/
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /valhalla-agent ./cmd/agent/

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache git && adduser -D -u 1000 warrior
COPY --from=build /valhalla-agent /usr/local/bin/valhalla-agent
USER warrior
WORKDIR /workspace
EXPOSE 8081
ENTRYPOINT ["valhalla-agent"]
