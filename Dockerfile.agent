# Build stage
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY pkg/ pkg/
RUN go vet ./...
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /valhalla-agent ./cmd/agent/

# Runtime stage
FROM golang:1.23-alpine
RUN apk add --no-cache git curl jq python3 && adduser -D -u 1000 warrior
COPY scripts/apply_patch.py /usr/local/bin/apply_patch
RUN chmod +x /usr/local/bin/apply_patch
COPY --from=build /valhalla-agent /usr/local/bin/valhalla-agent
USER warrior
WORKDIR /workspace
EXPOSE 8081
ENTRYPOINT ["valhalla-agent"]
